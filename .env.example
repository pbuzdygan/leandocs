# Copy to .env for local overrides (never commit .env)
PORT=8080
HOST=0.0.0.0
DATA_DIR=./data
LOG_LEVEL=info
# Add a UUID to documents that have none (only missing front matter fields are added)
ASSIGN_MISSING_IDS=true
# Detect changes made outside the app: native, poll (network shares) or off
WATCH_MODE=native
# Set true when the browser accesses LeanDocs through an HTTPS reverse proxy.
SESSION_COOKIE_SECURE=false
# Optional fixed browser origin; set your HTTPS domain for a deployed installation.
# PUBLIC_ORIGIN=https://docs.example.com
# Keep local for an ordinary HTTPS reverse proxy such as Nginx Proxy Manager.
AUTH_MODE=local
# Only for a gateway that authenticates the allowed user and overwrites the identity header:
# AUTH_MODE=proxy
# PROXY_TRUSTED_IPS=192.0.2.10
# PROXY_AUTH_HEADER=x-auth-request-user
# PROXY_AUTH_USER=owner@example.com
# AUTH_MODE=none disables login: anyone with network access can read, edit and delete documents.
# Keep AUTH_MODE=local for your public Nginx Proxy Manager deployment.
# Maximum attachment size per file, in bytes (also passed through by docker compose)
MAX_UPLOAD_SIZE=52428800

# --- docker compose (compose.yaml and compose_local_build.yaml) ---
# LEANDOCS_TAG=latest              # compose.yaml: image version to run, e.g. 1.0.0
# LEANDOCS_IMAGE=ghcr.io/pbuzdygan/leandocs
# LEANDOCS_PORT=8090
# LEANDOCS_BIND=127.0.0.1          # listen only on this host address
# LEANDOCS_UID=1000
# LEANDOCS_GID=1000
